# Nebius Token Factory key (https://tokenfactory.nebius.com/project/api-keys). Used when base_url contains "nebius".
NEBIUS_API_KEY=

# NVIDIA API key (https://build.nvidia.com/). Only needed if you point config.yaml at NVIDIA's endpoint.
NGC_API_KEY=

# Optional endpoint overrides (see config.yaml)
# VLM_BASE_URL=
# VLM_MODEL=
